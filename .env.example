# 元宝搜索 API
YUANBAO_API_URL=https://api.wsa.cloud.tencent.com/SearchPro
YUANBAO_API_KEY=

# 大模型
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 图片立案的视觉模型（OpenAI 兼容网关）；留空时图片立案返回「能力尚未部署」
# DeepSeek 可直接填 VISION_MODEL=deepseek-flash（该模型本身支持图片输入）
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=
# 向量化网关；留空时回退到 LLM_BASE_URL / LLM_API_KEY
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# 向量批量大小，默认 64
EMBEDDING_BATCH_SIZE=64

# 每个疑点的检索词条数，默认 1 条 pro + 2 条 con
SEARCH_PRO_COUNT=1
SEARCH_CON_COUNT=2
# 拆疑点时一并生成检索词（默认开启；设为 false 则每个疑点单独生成）
COMBINE_CLAIM_QUERIES=true

# 开发期使用本地缓存，不发起真实搜索
USE_MOCK=true

# 图像生成（skill: aizhentan-25）
AIZHENTAN_API_URL=https://lax.toklens.ai/v1
AIZHENTAN_API_KEY=
AIZHENTAN_MODEL=gpt-image-2.5-flare
